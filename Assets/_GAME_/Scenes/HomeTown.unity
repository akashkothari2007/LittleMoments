  typeDialogueAudio: {fileID: 8300000, guid: 1d03225de6146491ab8f2f3c8eb89772, type: 3}
  typeAudioSource: {fileID: 1016843640}
  mainCamera: {fileID: 519420031}
  continuePrompt: {fileID: 1468905205}
  currentDialogues: []
  typeDelay: 0.05
  introDialogues:
  - WELCOMEEEE to my little world!
  - Do you want to help me set some stuff up por favor? :)
  - Awesome!
  - 
  gardenPlots:
  - {fileID: 949457979}
  - {fileID: 176929355}
  - {fileID: 1793058693}
  - {fileID: 1976000442}
  - {fileID: 170328352}
  - {fileID: 2136206577}
  - {fileID: 1326059942}
  - {fileID: 580628638}
  plantFlowerDialogues:
  - The garden's looking a little bleh
  - Can you help me find 8 flowers to plant?
  - I only like the single blue and red flowers
  - Click on them when you are very close to pick them up!
  - And click inside the garden when you are close to plant!
  - HERE, there is one beside me whenever you are ready...
  flowersNeeded: 8
  flowersPlanted: 0
  pathSpots:
  - {fileID: 801486872}
  - {fileID: 1417888650}
  - {fileID: 805089936}
  - {fileID: 697374856}
  - {fileID: 115321950}
  - {fileID: 2101401749}
  - {fileID: 1137222782}
  placeStoneDialogues:
  - THAT LOOKS SO BEAUTIFUL
  - I LOVE THE FLOWERS YOU PICKED THANK YOUUU!!!
  - Theres something missing...
  - I think we need a stone path from the house to the pit
  - See the dark stones, you can push them around
  - Push 7 to form a path from the garden to the pit!
  stonesNeeded: 7
  stonesPlaced: 0
  fireSpot: {fileID: 1369191549}
  lightFireDialogues:
  - INCREDIBLE!!!
  - Its going to be dark soon, we need a campfire
  - See that pile of logs, you can click them to get logs!
  - We only need 3 logs to place into the firepit
  - Hmmmm, we need to light it somehow
  - Maybe you can find something to light it...
  fireLit: 0
  finishLightFireDialogues:
  - PERFECT TIMING IT'S GETTING DARK
  - Lets go sit by the campfire soon :)
  - Ill grab my guitar!!
  - 
  specialEffects: {fileID: 700258088}
  cutsceneObjects: {fileID: 1534699952}
  player: {fileID: 597752625}
  knight: {fileID: 735750448}
  guitarClip: {fileID: 8300000, guid: c825714b191564be7aef05ca7e867e4d, type: 3}
  campfire: {fileID: 903735322}
  guitar: {fileID: 1080189279}
  guitarClip2: {fileID: 8300000, guid: 26bfcacaedaeb4631b1acdd1756a7147, type: 3}
  skip: 0
  enterHouseDialogues:
  - ITS MORNING ALREADYYYY
  - Why dont we go into the house!
  houseLight: {fileID: 646671204}
